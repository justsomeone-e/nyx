# =========================================================
# GitHub Linguist Configuration for nyx Toolchain
# =========================================================

# Nyx is not currently a language in GitHub Linguist's language database.
# Keep C++ highlighting for .nyx/.he files, but do not misrepresent Nyx
# source as C++ in the repository language breakdown.
*.nyx linguist-language=C++ -linguist-detectable
*.he linguist-language=C++ -linguist-detectable

# These are authored project sources/tests, not vendored dependencies.
# They must remain visible in the language breakdown.
*.py -linguist-vendored
src/** -linguist-vendored
tests/** -linguist-vendored

# Exclude shell and automation scripts
*.ps1 linguist-vendored=true
*.sh linguist-vendored=true
install.ps1 linguist-vendored=true
install.sh linguist-vendored=true

# Exclude generated build output, documentation, and asset files
# Generated build output should not affect language statistics.
build/** linguist-generated
*.svg linguist-documentation=true
assets/** linguist-documentation=true
docs/** linguist-documentation=true
examples/** linguist-documentation=true
