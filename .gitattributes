# =========================================================
# GitHub Linguist Configuration for nyx Toolchain
# =========================================================

# Primary language: Map .nyx and .he directly to C++
*.nyx linguist-detectable=true linguist-language=C++
*.he linguist-detectable=true linguist-language=C++

# Exclude Python bootstrap, runtime, and tests from language breakdown
*.py linguist-vendored=true
src/** linguist-vendored=true
tests/** linguist-vendored=true

# Exclude shell and automation scripts
*.ps1 linguist-vendored=true
*.sh linguist-vendored=true
install.ps1 linguist-vendored=true
install.sh linguist-vendored=true

# Exclude extensions, build, documentation, and asset files
extensions/** linguist-vendored=true
build/** linguist-vendored=true
*.svg linguist-documentation=true
assets/** linguist-documentation=true
docs/** linguist-documentation=true
examples/** linguist-documentation=true