{
  "name": "nyx-language-support",
  "displayName": "nyx Language Support & IntelliSense",
  "description": "Syntax highlighting, snippets, and rich IntelliSense for nyx (.nyx)",
  "version": "2.0.0",
  "publisher": "nyx",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:nyxlang"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nyxlang",
        "aliases": ["nyx", "Nyx", "nyxlang", "he"],
        "extensions": [".nyx", ".he"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nyxlang",
        "scopeName": "source.nyx",
        "path": "./syntaxes/nyx.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "nyxlang",
        "path": "./snippets/nyx.snippets.json"
      }
    ]
  }
}
