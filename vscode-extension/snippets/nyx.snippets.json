{
  "Target Directive": {
    "prefix": "#target",
    "body": [
      "#target ${1|hecpp,heasm,hereact,hejs,hers,hepy,hewasm|}"
    ],
    "description": "Specify compilation backend target"
  },
  "Native Include Directive": {
    "prefix": "#native include",
    "body": [
      "#native include <${1:iostream}>"
    ],
    "description": "Include C/C++ native header"
  },
  "Native Raw Block": {
    "prefix": "#native raw",
    "body": [
      "#native raw {",
      "\t${0:// raw C++ code}",
      "}"
    ],
    "description": "Direct native C++ code injection"
  },
  "Native Link Directive": {
    "prefix": "#native link",
    "body": [
      "#native link \"${1:ws2_32}\""
    ],
    "description": "Link system static or dynamic library"
  },
  "Function Definition": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) -> ${3:type} {",
      "\treturn ${4:result};",
      "}"
    ],
    "description": "Strongly typed function definition"
  },
  "Struct Definition": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:type}",
      "}"
    ],
    "description": "Custom data structure definition"
  },
  "Impl Block": {
    "prefix": "impl",
    "body": [
      "impl ${1:StructName} {",
      "\tfn ${2:method_name}(self${3:, params}) -> ${4:type} {",
      "\t\t${0:// body}",
      "\t}",
      "}"
    ],
    "description": "Struct method implementation block"
  },
  "Variable Declaration": {
    "prefix": "var",
    "body": [
      "var ${1:name} = ${2:value};"
    ],
    "description": "Mutable variable with type inference"
  },
  "Constant Declaration": {
    "prefix": "const",
    "body": [
      "const ${1:NAME} = ${2:value};"
    ],
    "description": "Immutable compile-time constant"
  },
  "If Condition": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t${0:// body}",
      "}"
    ],
    "description": "Conditional branch"
  },
  "If Else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} {",
      "\t${2:// true branch}",
      "} else {",
      "\t${0:// false branch}",
      "}"
    ],
    "description": "If-Else branch"
  },
  "For Range Loop": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:0}..${3:10}-1 {",
      "\t${0:// body}",
      "}"
    ],
    "description": "Contiguous range loop"
  },
  "For In Collection": {
    "prefix": "for_in",
    "body": [
      "for ${1:item} in ${2:collection} {",
      "\t${0:// process item}",
      "}"
    ],
    "description": "Iterate over collection items"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t${0:// body}",
      "}"
    ],
    "description": "While loop"
  },
  "Match Expression": {
    "prefix": "match",
    "body": [
      "match ${1:expr} {",
      "\t${2:pattern} => ${3:result},",
      "\t\"_\" => ${0:default}",
      "}"
    ],
    "description": "Pattern matching block"
  },
  "Unsafe Memory Block": {
    "prefix": "unsafe",
    "body": [
      "unsafe {",
      "\tvar ptr = addr(${1:target});",
      "\tvar val = peek(ptr);",
      "\t${0}",
      "}"
    ],
    "description": "Direct memory hardware access"
  },
  "In-File Unit Test": {
    "prefix": "test",
    "body": [
      "test \"${1:test description}\" {",
      "\tassert(${2:condition}, \"${3:failure explanation}\");",
      "}"
    ],
    "description": "Automated unit test definition"
  },
  "Print Statement": {
    "prefix": "print",
    "body": [
      "print(${1:\"message\"});"
    ],
    "description": "Print to console output"
  },
  "React useState Hook": {
    "prefix": "useState",
    "body": [
      "var [${1:state}, set${1/(.*)/${1:/capitalize}/}] = useState(${2:initialValue});"
    ],
    "description": "React state declaration hook"
  },
  "React useEffect Hook": {
    "prefix": "useEffect",
    "body": [
      "useEffect(() => {",
      "\t${0:// side effect}",
      "}, [${1:deps}]);"
    ],
    "description": "React lifecycle side effect hook"
  }
}