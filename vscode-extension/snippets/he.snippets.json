{
  "Target Directive": {
    "prefix": "target",
    "body": [
      "#target ${1|hecpp,hejs,hepy,heasm|} // Note: Only 1 #target allowed per file (Tek dosyada yalnizca 1 #target kullanilabilir)"
    ],
    "description": "Set HolyEasyLang Compilation Target"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:function_name}(${2:params}):",
      "\t${0:// body}",
      "\treturn ${3:result}"
    ],
    "description": "Define a HolyEasyLang Function"
  },
  "Use Module": {
    "prefix": "use",
    "body": [
      "use std:${1|math,time,fs,net|}"
    ],
    "description": "Import Universal Standard Module"
  },
  "If Condition": {
    "prefix": "if",
    "body": [
      "if ${1:condition}:",
      "\t${0:// then block}",
      "else:",
      "\t"
    ],
    "description": "If-Else Conditional Block"
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:1}..${3:10}:",
      "\t${0:print($1)}"
    ],
    "description": "For Range Loop"
  },
  "While Loop": {
    "prefix": "loop",
    "body": [
      "loop ${1:condition}:",
      "\t${0:// loop body}"
    ],
    "description": "Loop / While Block"
  },
  "Print": {
    "prefix": "print",
    "body": [
      "print(${1:\"message\"})"
    ],
    "description": "Print to Standard Output"
  },
  "Variable": {
    "prefix": "var",
    "body": [
      "var ${1:name} = ${2:value}"
    ],
    "description": "Declare Variable"
  }
}
