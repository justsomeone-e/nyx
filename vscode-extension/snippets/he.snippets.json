{
  "Target Directive": {
    "prefix": "#target",
    "body": [
      "#target ${1|hecpp,heasm,hereact,hejs,hers,hepy,hewasm|}"
    ],
    "description": "Specify compilation backend target"
  },
  "Native Include Directive": {
    "prefix": "#native include",
    "body": [
      "#native include <${1:windows.h}>"
    ],
    "description": "Include C/C++ native header"
  },
  "Native Raw Block": {
    "prefix": "#native raw",
    "body": [
      "#native raw {",
      "\t${0:// raw C++ code}",
      "}"
    ],
    "description": "Direct native C++ code injection"
  },
  "Native Link Directive": {
    "prefix": "#native link",
    "body": [
      "#native link \"${1:ws2_32}\""
    ],
    "description": "Link system static or dynamic library"
  },
  "Defer Statement": {
    "prefix": "defer",
    "body": [
      "defer ${1:cleanup_func()};"
    ],
    "description": "Executes cleanup action automatically upon scope exit (LIFO order)"
  },
  "Guard Statement": {
    "prefix": "guard",
    "body": [
      "guard ${1:condition} else {",
      "\t${0:return;}",
      "}"
    ],
    "description": "Early-exit safety guard block"
  },
  "Pipeline Operator": {
    "prefix": "|>",
    "body": [
      "|> ${1:func_name}"
    ],
    "description": "Pipes value forward as the first argument of the target function"
  },
  "String Interpolation": {
    "prefix": "$\"",
    "body": [
      "$\"${1:Hello} {${2:name}}\""
    ],
    "description": "Interpolated string expression"
  },
  "Function Definition": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) -> ${3:type} {",
      "\t${0:// body}",
      "\treturn ${4:result};",
      "}"
    ],
    "description": "Strongly typed function definition"
  },
  "Struct Definition": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:type}",
      "}"
    ],
    "description": "Custom data structure definition"
  },
  "Impl Block": {
    "prefix": "impl",
    "body": [
      "impl ${1:StructName} {",
      "\tfn ${2:method_name}(self${3:, params}) -> ${4:type} {",
      "\t\t${0:// body}",
      "\t}",
      "}"
    ],
    "description": "Struct method implementation block"
  },
  "Variable Declaration": {
    "prefix": "var",
    "body": [
      "var ${1:name} = ${2:value};"
    ],
    "description": "Mutable variable declaration"
  },
  "Constant Declaration": {
    "prefix": "const",
    "body": [
      "const ${1:NAME} = ${2:value};"
    ],
    "description": "Immutable constant declaration"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t${0:// body}",
      "}"
    ],
    "description": "Conditional if branch"
  },
  "For Range Loop": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:0}..${3:count}-1 {",
      "\t${0:// body}",
      "}"
    ],
    "description": "Contiguous range for loop"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t${0:// body}",
      "}"
    ],
    "description": "Conditional while loop"
  },
  "Pattern Matching": {
    "prefix": "match",
    "body": [
      "match ${1:expr} {",
      "\t${2:pattern} => ${3:result},",
      "\t\"_\" => ${0:default}",
      "}"
    ],
    "description": "Match expression with exhaustive pattern matching"
  },
  "Print to Console": {
    "prefix": "print",
    "body": [
      "print(${1:expr});"
    ],
    "description": "Output expression to standard output"
  },
  "Unsafe Memory Block": {
    "prefix": "unsafe",
    "body": [
      "unsafe {",
      "\tvar ptr = addr(${1:variable});",
      "\tvar val = peek(ptr);",
      "\t${0}",
      "}"
    ],
    "description": "Hardware and raw pointer unsafe execution block"
  },
  "Unit Test Block": {
    "prefix": "test",
    "body": [
      "test \"${1:test title}\" {",
      "\tassert(${2:condition}, \"${3:failure message}\");",
      "}"
    ],
    "description": "In-file automated unit test block"
  }
}