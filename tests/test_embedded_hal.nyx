import "std/gpio";
import "std/serial";
import "std/mmio";

fn main() {
    print("=== [NYX EMBEDDED HAL & VOLATILE MMIO VERIFICATION] ===");
    
    // 1. Portable HAL GPIO API
    print("[HAL] Configuring Pin 13 as OUTPUT...");
    mode(13, PIN_OUTPUT);
    write(13, PIN_HIGH);
    print("[HAL] Pin 13 set to HIGH.");
    toggle(13);
    print("[HAL] Pin 13 toggled.");

    // 2. Portable HAL Serial UART API
    print("[HAL] Initializing Serial UART @ 115200 baud...");
    init(115200);
    println("[SERIAL] Hardware UART link online.");

    // 3. Low-level Volatile Memory-Mapped I/O (MMIO)
    var simulated_hardware_register = 0;
    unsafe {
        var reg_addr = addr(simulated_hardware_register);
        print($"[MMIO] Writing 0xDEADBEEF to volatile register at {reg_addr}...");
        write32(reg_addr, 3735928559);
        
        var read_back = read32(reg_addr);
        print($"[MMIO] Volatile read-back result: {read_back}");
        
        // Bit set / clear operations
        set_bits32(reg_addr, 1);
        var with_bit = read32(reg_addr);
        print($"[MMIO] After set_bits32 (0x01): {with_bit}");
    }

    print("[SUCCESS] Embedded HAL and Volatile MMIO layer verified 100%.");
}