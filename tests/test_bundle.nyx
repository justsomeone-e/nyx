var wasm_counter: int = 0

fn next_counter() -> int {
    set wasm_counter = wasm_counter + 1
    return wasm_counter
}

fn add_numbers(a: int, b: int) -> int {
    return a + b;
}

fn is_positive(value: int) -> bool {
    return value > 0;
}

fn compute_power(base: int, exp: int) -> int {
    var res = 1;
    for i in 1..exp {
        res = res * base;
    }
    return res;
}

fn greet_developer(name: string) -> string {
    return $"Hello from Nyx WebAssembly, {name}!";
}

fn sum_values(values: Array<int>) -> int {
    var total: int = 0
    for value in values {
        if value == 0 { continue }
        set total = total + value
    }
    return total
}

fn sum_float_values(values: Array<float>) -> float {
    var total: float = 0.0
    for value in values {
        set total = total + value
    }
    return total
}

fn array_length(values: Array<int>) -> int {
    return values.len()
}

fn string_length(value: string) -> int {
    return value.len()
}

fn choose_label(enabled: bool, name: string) -> string {
    return if enabled { "enabled: " + name } else { "disabled: " + name }
}

fn echo_inner(value: string) -> string {
    return value;
}

fn echo_via_call(value: string) -> string {
    return echo_inner(value);
}

fn literal_via_call() -> string {
    return echo_inner("internal UTF-8: İstanbul 🌙");
}

fn main() {
    print("Bundle source ready.");
}
