#target cpp
#native include <windows.h>
#native include <iostream>
#native include <vector>
#native include <chrono>
#native include <cmath>

fn main() {
    print("=== [NYX NATIVE HARDWARE & C++20 VERIFICATION] ===");
    
    // 1. Win32 Native API Call
    #native raw {
        DWORD pid = GetCurrentProcessId();
        ULONGLONG uptime_ms = GetTickCount64();
        std::cout << "[WIN32 OK] Current Process ID: " << pid << " | Uptime: " << uptime_ms << " ms\n";
    }

    // 2. C++ STL Vector & Chrono High-Resolution Clock
    #native raw {
        std::vector<int> nums = {10, 20, 30, 40, 50};
        int sum = 0;
        for (int n : nums) sum += n;
        
        auto start = std::chrono::high_resolution_clock::now();
        double root = std::sqrt(sum);
        auto end = std::chrono::high_resolution_clock::now();
        auto diff = std::chrono::duration_cast<std::chrono::nanoseconds>(end - start).count();
        
        std::cout << "[STL OK] Vector Sum: " << sum << " | Sqrt: " << root << " (" << diff << " ns)\n";
    }

    // 3. Nyx Core + Native Pointers
    var x = 1337;
    unsafe {
        var p = addr(x);
        var val = peek(p);
        print("[NYX OK] Memory pointer addr: " + to_string(p) + " -> value: " + to_string(val));
    }

    print("[SUCCESS] All native headers and hardware APIs compiled & executed flawlessly.");
}