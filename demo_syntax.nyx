#target cpp

var target_name = "24K SAF ALTIN"
var base_freq = 5000
var mineral_offset = 24

fn calculate_target_freq(base, offset):
    var final_hz = base + offset
    return final_hz

var current_hz = calculate_target_freq(base_freq, mineral_offset)
var signal_strength = 85

print("========================================")
print("🎯 HEDEF MADDE:", target_name)
print("⚡ CALISMA FREKANSI:", current_hz, "Hz")
print("📶 SINYAL SEVIYESI: %", signal_strength)
print("========================================")

if signal_strength >= 80:
    print("✅ Hedefe Kilitlenildi! (Yuksek Rezonans)")
else:
    print("⚠️ Zayıf Manyetik Sinyal, Aramaya Devam...")

print("Taramalar Tamamlandi!")
