/// nyx Low-Level Memory-Mapped I/O (MMIO) Volatile Register Primitives

extern "C" fn nyx_mmio_read8(address: uintptr) -> int;
extern "C" fn nyx_mmio_write8(address: uintptr, val: int);
extern "C" fn nyx_mmio_read16(address: uintptr) -> int;
extern "C" fn nyx_mmio_write16(address: uintptr, val: int);
extern "C" fn nyx_mmio_read32(address: uintptr) -> int;
extern "C" fn nyx_mmio_write32(address: uintptr, val: int);

fn read8(address: uintptr) -> int {
    return nyx_mmio_read8(address);
}

fn write8(address: uintptr, val: int) {
    nyx_mmio_write8(address, val);
}

fn read16(address: uintptr) -> int {
    return nyx_mmio_read16(address);
}

fn write16(address: uintptr, val: int) {
    nyx_mmio_write16(address, val);
}

fn read32(address: uintptr) -> int {
    return nyx_mmio_read32(address);
}

fn write32(address: uintptr, val: int) {
    nyx_mmio_write32(address, val);
}

fn set_bits32(address: uintptr, mask: int) {
    var cur = nyx_mmio_read32(address);
    nyx_mmio_write32(address, cur | mask);
}

fn clear_bits32(address: uintptr, mask: int) {
    var cur = nyx_mmio_read32(address);
    nyx_mmio_write32(address, cur & (~mask));
}

fn update32(address: uintptr, clear_mask: int, set_mask: int) {
    critical {
        var current = nyx_mmio_read32(address)
        nyx_mmio_write32(address, (current & (~clear_mask)) | set_mask)
    }
}

fn read_bit32(address: uintptr, bit: int) -> bool {
    return (nyx_mmio_read32(address) & (1 << bit)) != 0
}

fn write_field32(address: uintptr, mask: int, shift: int, value: int) {
    update32(address, mask, (value << shift) & mask)
}
