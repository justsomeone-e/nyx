/// nyx Standard Hardware Abstraction Layer - UART / Serial Bus

extern "C" fn nyx_hal_serial_init(baud: int);
extern "C" fn nyx_hal_serial_write(data: string);
extern "C" fn nyx_hal_serial_write_byte(b: int);
extern "C" fn nyx_hal_serial_read_byte() -> int;
extern "C" fn nyx_hal_serial_available() -> bool;

fn init(baudrate: int = 115200) {
    nyx_hal_serial_init(baudrate);
}

fn print_str(msg: string) {
    nyx_hal_serial_write(msg);
}

fn println(msg: string) {
    nyx_hal_serial_write(msg + "\r\n");
}

fn write_byte(b: int) {
    nyx_hal_serial_write_byte(b);
}

fn read_byte() -> int {
    return nyx_hal_serial_read_byte();
}

fn available() -> bool {
    return nyx_hal_serial_available();
}