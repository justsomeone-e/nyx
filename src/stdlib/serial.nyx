/// nyx Standard Hardware Abstraction Layer - UART / Serial Bus

extern "C" fn nyx_hal_serial_init(baud: int) -> bool;
extern "C" fn nyx_hal_serial_write(data: string) -> int;
extern "C" fn nyx_hal_serial_write_byte(b: int) -> bool;
extern "C" fn nyx_hal_serial_write_buffer(data: uintptr, length: int) -> int;
extern "C" fn nyx_hal_serial_read_buffer(data: uintptr, capacity: int) -> int;
extern "C" fn nyx_hal_serial_read_byte() -> int;
extern "C" fn nyx_hal_serial_available() -> bool;

fn init(baudrate: int = 115200) -> bool {
    return nyx_hal_serial_init(baudrate);
}

fn print_str(msg: string) -> int {
    return nyx_hal_serial_write(msg);
}

fn println(msg: string) -> int {
    return nyx_hal_serial_write(msg + "\r\n");
}

fn write_byte(b: int) -> bool {
    return nyx_hal_serial_write_byte(b);
}

fn write_bytes(data: uintptr, length: int) -> int {
    return nyx_hal_serial_write_buffer(data, length);
}

fn read_bytes(data: uintptr, capacity: int) -> int {
    return nyx_hal_serial_read_buffer(data, capacity);
}

fn read_byte() -> int {
    return nyx_hal_serial_read_byte();
}

fn available() -> bool {
    return nyx_hal_serial_available();
}
