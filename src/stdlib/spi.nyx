/// Nyx STM32 SPI master API. Handles are physical bus numbers; failures are
/// negative so a disconnected or timed-out peripheral is never reported as OK.

const SPI_MODE_0: int = 0
const SPI_MODE_1: int = 1
const SPI_MODE_2: int = 2
const SPI_MODE_3: int = 3

extern "C" fn nyx_hal_spi_init(bus: int, frequency: int, mode: int) -> bool
extern "C" fn nyx_hal_spi_transfer(bus: int, value: int) -> int
extern "C" fn nyx_hal_spi_write_buffer(bus: int, data: uintptr, length: int) -> int
extern "C" fn nyx_hal_spi_transfer_buffer(bus: int, transmit: uintptr, receive: uintptr, length: int) -> int
extern "C" fn nyx_hal_spi_close(bus: int) -> void

fn spi_open(bus: int, frequency: int = 1000000, mode: int = SPI_MODE_0) -> int {
    if nyx_hal_spi_init(bus, frequency, mode) {
        return bus
    }
    return -1
}

fn spi_transfer(handle: int, value: int) -> int {
    return nyx_hal_spi_transfer(handle, value)
}

fn spi_repeat(handle: int, value: int, count: int) -> int {
    var transferred = 0
    while transferred < count {
        var result = nyx_hal_spi_transfer(handle, value)
        if result < 0 { return result }
        set transferred = transferred + 1
    }
    return transferred
}

fn spi_write(handle: int, data: uintptr, length: int) -> int {
    return nyx_hal_spi_write_buffer(handle, data, length)
}

fn spi_exchange(handle: int, transmit: uintptr, receive: uintptr, length: int) -> int {
    return nyx_hal_spi_transfer_buffer(handle, transmit, receive, length)
}

fn spi_close(handle: int) -> void {
    nyx_hal_spi_close(handle)
}
