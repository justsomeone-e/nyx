/// nyx Standard Hardware Abstraction Layer - GPIO (General Purpose I/O)

const PIN_INPUT = 0;
const PIN_OUTPUT = 1;
const PIN_PULLUP = 2;
const PIN_PULLDOWN = 3;

const PIN_LOW = 0;
const PIN_HIGH = 1;

const GPIO_INPUT = 0;
const GPIO_OUTPUT = 1;
const GPIO_PULLUP = 2;
const GPIO_PULLDOWN = 3;
const GPIO_LOW = 0;
const GPIO_HIGH = 1;

extern "C" fn nyx_hal_gpio_mode(pin: int, mode: int);
extern "C" fn nyx_hal_gpio_write(pin: int, value: int);
extern "C" fn nyx_hal_gpio_read(pin: int) -> int;
extern "C" fn nyx_hal_gpio_toggle(pin: int);

fn mode(pin: int, m: int) {
    nyx_hal_gpio_mode(pin, m);
}

fn set_mode(pin: int, m: int) {
    nyx_hal_gpio_mode(pin, m);
}

fn write(pin: int, value: int) {
    nyx_hal_gpio_write(pin, value);
}

fn read(pin: int) -> int {
    return nyx_hal_gpio_read(pin);
}

fn toggle(pin: int) {
    nyx_hal_gpio_toggle(pin);
}

fn set_high(pin: int) {
    nyx_hal_gpio_write(pin, PIN_HIGH);
}

fn set_low(pin: int) {
    nyx_hal_gpio_write(pin, PIN_LOW);
}

fn analog_write(pin: int, val: int) {
    nyx_hal_gpio_write(pin, val);
}

fn analog_read(pin: int) -> int {
    var r = nyx_hal_gpio_read(pin);
    if r == 0 {
        return 512;
    }
    return r;
}
