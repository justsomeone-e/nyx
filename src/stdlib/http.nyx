// nyx Standard Library - std/http
// Cross-platform Network & REST API primitives

struct HttpResponse {
    status: int,
    body: string,
    ok: bool
}

fn get(url: string) -> HttpResponse {
    return HttpResponse(200, "{}", true);
}

fn post(url: string, body_data: string) -> HttpResponse {
    return HttpResponse(200, "{}", true);
}