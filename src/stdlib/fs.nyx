// nyx Standard Library - std/fs
// Cross-Platform Native Filesystem I/O Primitives

#native include "fstream"
#native include "sstream"
#native include "string"

#native raw {
inline std::string _nyx_fs_read_to_string(const std::string& path) {
    std::ifstream file(path);
    if (!file.is_open()) return "";
    std::stringstream buffer;
    buffer << file.rdbuf();
    return buffer.str();
}

inline bool _nyx_fs_write_string(const std::string& path, const std::string& content) {
    std::ofstream file(path);
    if (!file.is_open()) return false;
    file << content;
    return true;
}

inline bool _nyx_fs_append_string(const std::string& path, const std::string& content) {
    std::ofstream file(path, std::ios::app);
    if (!file.is_open()) return false;
    file << content;
    return true;
}

inline bool _nyx_fs_exists(const std::string& path) {
    std::ifstream file(path);
    return file.good();
}

inline bool _nyx_fs_remove_file(const std::string& path) {
    return std::remove(path.c_str()) == 0;
}
}

fn read_to_string(path: string) -> string {
    return _nyx_fs_read_to_string(path);
}

fn write_string(path: string, content: string) -> bool {
    return _nyx_fs_write_string(path, content);
}

fn append_string(path: string, content: string) -> bool {
    return _nyx_fs_append_string(path, content);
}

fn exists(path: string) -> bool {
    return _nyx_fs_exists(path);
}

fn remove_file(path: string) -> bool {
    return _nyx_fs_remove_file(path);
}