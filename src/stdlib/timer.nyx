/// General-purpose STM32 timer API. F401/F411/F446 expose timers 2, 3, and 4;
/// the F410 profile exposes timers 5 and 6. Unsupported timer numbers return
/// false/-1. Interrupt mode also enables the matching board NVIC line.

extern "C" fn nyx_hal_timer_start(timer: int, frequency: int, with_interrupt: bool) -> bool
extern "C" fn nyx_hal_timer_stop(timer: int) -> void
extern "C" fn nyx_hal_timer_clear_update(timer: int) -> void
extern "C" fn nyx_hal_timer_counter(timer: int) -> int

fn timer_start(timer: int, frequency: int, with_interrupt: bool = false) -> bool {
    return nyx_hal_timer_start(timer, frequency, with_interrupt)
}

fn timer_stop(timer: int) -> void {
    nyx_hal_timer_stop(timer)
}

fn timer_clear_update(timer: int) -> void {
    nyx_hal_timer_clear_update(timer)
}

fn timer_counter(timer: int) -> int {
    return nyx_hal_timer_counter(timer)
}
