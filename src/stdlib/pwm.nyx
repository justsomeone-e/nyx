/// STM32 timer-backed PWM. Duty is expressed in per-mille (0..1000) so it
/// remains deterministic without floating-point support.

extern "C" fn nyx_hal_pwm_init(pin: int, frequency: int) -> bool
extern "C" fn nyx_hal_pwm_write(pin: int, duty_per_mille: int) -> bool

fn pwm_open(pin: int, frequency: int = 1000) -> bool {
    return nyx_hal_pwm_init(pin, frequency)
}

fn pwm_write(pin: int, duty_per_mille: int) -> bool {
    return nyx_hal_pwm_write(pin, duty_per_mille)
}

fn pwm_percent(pin: int, percent: int) -> bool {
    return nyx_hal_pwm_write(pin, percent * 10)
}
