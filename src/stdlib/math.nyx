// nyx Standard Library - std/math
// High-performance Mathematical Functions and Constants

#native include "cmath"
#native include "algorithm"

#native raw {
inline double _nyx_math_sin(double x) { return std::sin(x); }
inline double _nyx_math_cos(double x) { return std::cos(x); }
inline double _nyx_math_tan(double x) { return std::tan(x); }
inline double _nyx_math_sqrt(double x) { return std::sqrt(x); }
inline double _nyx_math_pow(double b, double e) { return std::pow(b, e); }
inline double _nyx_math_abs(double x) { return std::abs(x); }
inline double _nyx_math_floor(double x) { return std::floor(x); }
inline double _nyx_math_ceil(double x) { return std::ceil(x); }
inline double _nyx_math_round(double x) { return std::round(x); }
inline double _nyx_math_clamp(double val, double low, double high) { return std::clamp(val, low, high); }
}

const PI = 3.141592653589793;
const E = 2.718281828459045;

fn sin(x: float) -> float { return _nyx_math_sin(x); }
fn cos(x: float) -> float { return _nyx_math_cos(x); }
fn tan(x: float) -> float { return _nyx_math_tan(x); }
fn sqrt(x: float) -> float { return _nyx_math_sqrt(x); }
fn pow(b: float, e: float) -> float { return _nyx_math_pow(b, e); }
fn absolute(x: float) -> float { return _nyx_math_abs(x); }
fn floor(x: float) -> float { return _nyx_math_floor(x); }
fn ceil(x: float) -> float { return _nyx_math_ceil(x); }
fn round(x: float) -> float { return _nyx_math_round(x); }
fn clamp(val: float, low: float, high: float) -> float { return _nyx_math_clamp(val, low, high); }