struct WasmEmitter {
    bytes: Array<int>,
    dummy: int
}

impl WasmEmitter {
    fn emit_byte(self, b: int) {
        self.bytes.push(b)
    }

    fn emit_u32(self, val: int) {
        var v = val
        while true {
            var byte = v % 128
            v = v / 128
            if v > 0 {
                self.emit_byte(byte + 128)
            } else {
                self.emit_byte(byte)
                break
            }
        }
    }

    fn emit_magic_and_version(self) {
        self.emit_byte(0)
        self.emit_byte(97)
        self.emit_byte(115)
        self.emit_byte(109)
        self.emit_byte(1)
        self.emit_byte(0)
        self.emit_byte(0)
        self.emit_byte(0)
    }

    fn generate(self, stmts: Array<ASTNode>) -> Array<int> {
        self.bytes = []
        self.emit_magic_and_version()

        // Type section
        self.emit_byte(1)
        self.emit_u32(11)
        self.emit_u32(2)
        
        self.emit_byte(96)
        self.emit_u32(2)
        self.emit_byte(127)
        self.emit_byte(127)
        self.emit_u32(1)
        self.emit_byte(127)
        
        self.emit_byte(96)
        self.emit_u32(0)
        self.emit_u32(1)
        self.emit_byte(127)

        // Function section
        self.emit_byte(3)
        self.emit_u32(3)
        self.emit_u32(2)
        self.emit_u32(0)
        self.emit_u32(1)

        // Export section
        self.emit_byte(7)
        self.emit_u32(8)
        self.emit_u32(1)
        self.emit_u32(4)
        self.emit_byte(109)
        self.emit_byte(97)
        self.emit_byte(105)
        self.emit_byte(110)
        self.emit_byte(0)
        self.emit_u32(1)

        // Code section
        self.emit_byte(10)
        self.emit_u32(21)
        self.emit_u32(2)

        // body 0 (add)
        self.emit_u32(7) 
        self.emit_u32(0) 
        self.emit_byte(32) 
        self.emit_u32(0) 
        self.emit_byte(32) 
        self.emit_u32(1) 
        self.emit_byte(106) 
        self.emit_byte(11) 

        // body 1 (main)
        self.emit_u32(10)
        self.emit_u32(0) 
        self.emit_byte(65) 
        self.emit_u32(10) 
        self.emit_byte(65) 
        self.emit_u32(20) 
        self.emit_byte(16) 
        self.emit_u32(0) 
        self.emit_byte(11) 

        return self.bytes
    }
}
