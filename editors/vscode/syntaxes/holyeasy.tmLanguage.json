{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nyx",
  "scopeName": "source.nyx",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#directives" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.triple-slash.nyx",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.nyx",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nyx",
          "match": "\\b(if|else|elif|while|for|in|return|break|continue|match|try|catch|test)\\b"
        },
        {
          "name": "keyword.declaration.nyx",
          "match": "\\b(fn|var|val|struct|trait|impl|enum|type|unsafe)\\b"
        },
        {
          "name": "constant.language.boolean.nyx",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.nyx",
          "match": "\\b(int|float|string|bool|void|Array|Result)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.nyx",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.nyx",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.nyx",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.nyx",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.numeric.hex.nyx",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.other.directive.nyx",
          "match": "^\\s*#target\\s+(hecpp|hepy|hejs|hers|hereact|hewasm)\\b"
        }
      ]
    }
  }
}
