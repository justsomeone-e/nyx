#target cpp

#native include <conio.h>
extern "C" fn _kbhit() -> i32;
extern "C" fn _getch() -> i32;

// =======================================================
// Nyx Arcade: LIVE Real-Time Pong Game
// Real-time keyboard input (NO ENTER NEEDED!)
// Controls: 'w' = Up, 's' = Down, 'q' = Quit
// First to 3 points wins!
// =======================================================

fn main() {
    let width: int = 30
    let height: int = 12

    var ball_x: int = 15
    var ball_y: int = 6
    var dx: int = 1
    var dy: int = 1

    var p1_y: int = 4
    var p2_y: int = 4

    var score_p1: int = 0
    var score_p2: int = 0
    let winning_score: int = 3

    var playing: bool = true
    var status_msg: string = "Game started! Use W/S to move."

    print("========================================")
    print("      NYX REAL-TIME PONG ARCADE         ")
    print("========================================")
    print("Controls: Press 'W' for UP, 'S' for DOWN (No Enter!)")
    print("Press 'Q' to quit anytime.")
    print("Starting in 2 seconds...")
    delay_ms(2000)

    while playing {
        // 1. Non-blocking Keyboard Input (NO ENTER NEEDED!)
        if _kbhit() != 0 {
            let key: i32 = _getch()
            // 'w' or 'W'
            if (key == 119 or key == 87) and p1_y > 1 {
                p1_y = p1_y - 1
            }
            // 's' or 'S'
            elif (key == 115 or key == 83) and p1_y < height - 4 {
                p1_y = p1_y + 1
            }
            // 'q' or 'Q'
            elif key == 113 or key == 81 {
                playing = false
                status_msg = "Game exited by player."
            }
        }

        if playing {
            // 2. Ball Physics Update
            ball_x = ball_x + dx
            ball_y = ball_y + dy

            // Wall Bounces (Top & Bottom)
            if ball_y <= 1 {
                ball_y = 1
                dy = 1
            }
            if ball_y >= height - 2 {
                ball_y = height - 2
                dy = -1
            }

            // 3. CPU Paddle AI (tracks the ball with small delay)
            if p2_y + 1 < ball_y and p2_y < height - 4 {
                p2_y = p2_y + 1
            } elif p2_y + 1 > ball_y and p2_y > 1 {
                p2_y = p2_y - 1
            }

            // 4. Paddle Collisions
            // Player paddle (Left: x = 2, length = 3)
            if ball_x <= 2 and ball_y >= p1_y and ball_y <= p1_y + 2 {
                ball_x = 3
                dx = 1
                status_msg = "NICE HIT! You returned the ball!"
            }

            // CPU paddle (Right: x = width - 3, length = 3)
            if ball_x >= width - 3 and ball_y >= p2_y and ball_y <= p2_y + 2 {
                ball_x = width - 4
                dx = -1
            }

            // 5. Scoring
            if ball_x <= 0 {
                score_p2 = score_p2 + 1
                status_msg = "POINT FOR CPU! Keep your guard up!"
                ball_x = 15
                ball_y = 6
                dx = 1
                delay_ms(300)
            }
            if ball_x >= width - 1 {
                score_p1 = score_p1 + 1
                status_msg = "GOAL! You scored against CPU!"
                ball_x = 15
                ball_y = 6
                dx = -1
                delay_ms(300)
            }

            // 6. Check Win Condition
            if score_p1 >= winning_score {
                status_msg = "VICTORY! You defeated the CPU!"
                playing = false
            } elif score_p2 >= winning_score {
                status_msg = "DEFEAT! CPU took the match!"
                playing = false
            }

            // 7. Render Screen in-place (ANSI position)
            print("")
            print($"Score: [YOU] {score_p1}   vs   {score_p2} [CPU]  |  {status_msg}")
            print("+----------------------------+")

            for y in 1..height-2 {
                var row: string = "|"
                for x in 1..width-2 {
                    if x == ball_x and y == ball_y {
                        row = row + "O"
                    } elif x == 2 and y >= p1_y and y <= p1_y + 2 {
                        row = row + "["
                    } elif x == width - 3 and y >= p2_y and y <= p2_y + 2 {
                        row = row + "]"
                    } elif x == 15 {
                        row = row + ":"
                    } else {
                        row = row + " "
                    }
                }
                row = row + "|"
                print(row)
            }
            print("+----------------------------+")

            // Smooth 20 FPS game tick
            delay_ms(50)
        }
    }

    print("")
    print("========================================")
    print("FINAL RESULT: " + status_msg)
    print("========================================")
}
